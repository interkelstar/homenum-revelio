#!/usr/bin/env bash
# Homenum Revelio — reveal who else still has access to a host you were handed.
# Read-only. No network. No writes (except --save). Read me before you run me:
#   grep -nE 'curl|wget|/dev/tcp|/dev/udp|nc |ncat|telnet' revelio   # -> only the two signature regexes below
set -u

VERSION="0.1.0"

# ---- globals -----------------------------------------------------------------
REVELIO_ROOT="${REVELIO_ROOT:-}"   # read-prefix; "" means "/". e.g. /mnt for a mounted image
REVELIO_SELF="$0"
VERBOSE=0
USE_COLOR=1
NO_COLOR_FLAG=0
SAVE_FILE=""
THOROUGH=0

_ITEMS=()
_N_ATTENTION=0
_N_NORMAL=0
_BLINDSPOTS=()
_PM=""

# --- detection signatures (data we search FOR — NOT commands this tool runs) ----------
# Trust note: these two lines are the ONLY place network tokens (curl/wget/nc//dev/tcp)
# appear in this file. They are regexes matched against the CONTENTS of OTHER files.
FETCHEXEC_RE='(curl|wget)[^|]*\| *(sh|bash|zsh)|base64 +(-d|--decode)[^|]*\| *(sh|bash)'
REVSHELL_RE='bash -i|sh -i|/dev/tcp/|nc .*-e'

# ---- colour ------------------------------------------------------------------
setup_color() {
  if [ "$NO_COLOR_FLAG" -eq 1 ] || [ -n "${NO_COLOR:-}" ] || [ ! -t 1 ]; then
    USE_COLOR=0
  fi
  if [ "$USE_COLOR" -eq 1 ]; then
    C_RED=$'\e[31m'; C_YEL=$'\e[33m'; C_DIM=$'\e[2m'; C_BOLD=$'\e[1m'; C_RST=$'\e[0m'
  else
    C_RED=""; C_YEL=""; C_DIM=""; C_BOLD=""; C_RST=""
  fi
}

# ---- finding buffer ----------------------------------------------------------
# emit TIER CATEGORY TITLE DETAIL [REMEDIATION]
emit() {
  local tier="$1" category="$2" title="$3" detail="${4:-}" rem="${5:-}"
  title="$(_sanitize "$title")"
  detail="$(_sanitize "$detail")"
  rem="$(_sanitize "$rem")"
  local pd="${detail//$'\n'/$'\x1e'}"          # pack newlines so the record is one line
  _ITEMS+=("$tier"$'\x1f'"$category"$'\x1f'"$title"$'\x1f'"$pd"$'\x1f'"$rem")
  case "$tier" in
    attention) _N_ATTENTION=$((_N_ATTENTION + 1)) ;;
    normal)    _N_NORMAL=$((_N_NORMAL + 1)) ;;
  esac
}

blindspot() {
  local msg b
  msg="$(_sanitize "$1")"
  for b in "${_BLINDSPOTS[@]:-}"; do [ "$b" = "$msg" ] && return 0; done
  _BLINDSPOTS+=("$msg")
}

# replace control/escape bytes (keep TAB \011 and NEWLINE \012) with '?', so hostile
# filenames / key comments / cron lines can't inject terminal escape/cursor/OSC sequences
# into the operator's screen, corrupt the record framing, or hide findings. The '?' is
# itself a signal that something non-printing was present.
_sanitize() { printf '%s' "$1" | LC_ALL=C tr '\000-\010\013-\037\177' '?'; }

_print_detail() { # indent each line of a (newline-joined) detail block
  local block="$1" pre="$2" l
  [ -n "$block" ] || return 0
  while IFS= read -r l; do
    [ "${#l}" -gt 240 ] && l="${l:0:240} [...]"
    printf '      %s%s%s\n' "$pre" "$l" "$C_RST"
  done < <(printf '%s\n' "${block%$'\n'}")
}

revelio_render() {
  local rec tier cat title pd rem detail b
  printf '%sHomenum Revelio%s — access inventory for %s\n' "$C_BOLD" "$C_RST" "${REVELIO_ROOT:-/}"
  if [ -z "${_PM:-}" ] || [ "${_PM:-}" = none ]; then
    printf '%sno package manager detected — provenance unverifiable; every item shown for your review%s\n\n' "$C_YEL" "$C_RST"
  else
    printf '%sprovenance checked against the %s package database%s\n\n' "$C_DIM" "$_PM" "$C_RST"
  fi

  printf '%s↑ NEEDS YOUR EYES (%d)%s\n' "$C_RED" "$_N_ATTENTION" "$C_RST"
  [ "$_N_ATTENTION" -eq 0 ] && printf '  (none)\n'
  for rec in "${_ITEMS[@]:-}"; do
    [ -n "$rec" ] || continue
    IFS=$'\x1f' read -r tier cat title pd rem <<<"$rec"
    [ "$tier" = attention ] || continue
    detail="${pd//$'\x1e'/$'\n'}"
    printf '  %s•%s [%s] %s\n' "$C_RED" "$C_RST" "$cat" "$title"
    _print_detail "$detail" ""
    [ -n "$rem" ] && printf '      %s-> if not yours: %s%s\n' "$C_DIM" "$rem" "$C_RST"
  done
  printf '\n'

  if [ "$VERBOSE" -eq 1 ]; then
    printf '%s+ distro-normal (%d)%s\n' "$C_DIM" "$_N_NORMAL" "$C_RST"
    for rec in "${_ITEMS[@]:-}"; do
      [ -n "$rec" ] || continue
      IFS=$'\x1f' read -r tier cat title pd rem <<<"$rec"
      [ "$tier" = normal ] || continue
      detail="${pd//$'\x1e'/$'\n'}"
      printf '  %s+ [%s] %s%s\n' "$C_DIM" "$cat" "$title" "$C_RST"
      _print_detail "$detail" "$C_DIM"
    done
  else
    printf '%s+ distro-normal (%d) — package-owned; show with -v%s\n' \
           "$C_DIM" "$_N_NORMAL" "$C_RST"
  fi
  printf '\n'

  if [ "${#_BLINDSPOTS[@]}" -gt 0 ]; then
    printf "%s! COULDN'T CHECK WITHOUT ROOT (%d)%s\n" "$C_YEL" "${#_BLINDSPOTS[@]}" "$C_RST"
    for b in "${_BLINDSPOTS[@]}"; do printf '  • %s\n' "$b"; done
    printf '  %sre-run as root to include these: sudo %s%s\n\n' "$C_DIM" "$REVELIO_SELF" "$C_RST"
  fi

  printf 'This is the complete inventory we could read. You decide which you recognise.\n'
}

strip_ansi() { sed -E $'s/\x1b\\[[0-9;]*m//g'; }

# ---- command wrappers (overridable in tests) --------------------------------
revelio_ss()      { ss "$@"; }
revelio_getcap()  { getcap "$@"; }
revelio_ps()      { ps "$@"; }

# ---- provenance --------------------------------------------------------------
# Precedence: rpm first (RHEL/CentOS/Fedora are the primary handover targets),
# then dpkg (Debian/Ubuntu), pacman (Arch), apk (Alpine). If a tool is present but
# its DB doesn't own a queried path, pkg_owns returns 1 (not-owned) -> the item is
# shown as needs-eyes. That is the SAFE direction (loud, never silently "normal").
revelio_pm_detect() {
  if   command -v rpm    >/dev/null 2>&1; then _PM=rpm
  elif command -v dpkg   >/dev/null 2>&1; then _PM=dpkg
  elif command -v pacman >/dev/null 2>&1; then _PM=pacman
  elif command -v apk    >/dev/null 2>&1; then _PM=apk
  else _PM=none; fi
}

# REVELIO_ROOT is used unvalidated as a find(1)/path prefix throughout; a value
# beginning with '-' would be parsed by find as an expression (e.g. -delete),
# and a relative value makes every ${REVELIO_ROOT}/etc/... path relative to
# whatever the caller's cwd happens to be. Require empty or an absolute,
# existing directory.
_validate_revelio_root() {
  local r="${REVELIO_ROOT:-}"
  [ -z "$r" ] && return 0
  case "$r" in
    /*) ;;
    *) echo "revelio: REVELIO_ROOT must be an absolute path (got: $r)" >&2; return 1 ;;
  esac
  if [ ! -d "$r" ]; then
    echo "revelio: REVELIO_ROOT does not exist or is not a directory: $r" >&2
    return 1
  fi
  return 0
}

# pkg_owns PATH -> 0 owned, 1 not owned, 2 undeterminable
pkg_owns() {
  local p="$1"
  [ -e "$p" ] || return 2
  case "$_PM" in
    rpm)    rpm    -qf     "$p" >/dev/null 2>&1 ;;
    dpkg)   dpkg   -S      "$p" >/dev/null 2>&1 ;;
    pacman) pacman -Qo     "$p" >/dev/null 2>&1 ;;
    apk)    apk    info -W "$p" >/dev/null 2>&1 ;;
    *)      return 2 ;;
  esac
}

# classify_provenance PATH CATEGORY TITLE DETAIL REMEDIATION
# package-owned -> normal; not owned -> attention; undeterminable -> attention+note
classify_provenance() {
  local path="$1" cat="$2" title="$3" detail="$4" rem="${5:-}"
  local _rc=0
  pkg_owns "$path" || _rc=$?
  case $_rc in
    0) emit normal    "$cat" "$title" "$detail" "$rem" ;;
    1) emit attention "$cat" "$title" "$detail" "$rem" ;;
    2) emit attention "$cat" "$title (provenance undeterminable: no package manager)" "$detail" "$rem" ;;
  esac
}

# ---- cli ---------------------------------------------------------------------
usage() {
  cat <<'EOF'
revelio — reveal standing-access paths a previous owner could retain.

USAGE: revelio [options]

OPTIONS:
  -v, --verbose     also list package-owned ("distro-normal") items
      --no-color    disable ANSI colour
      --save FILE   write a plain-text copy of the report to FILE (the only write)
      --thorough    scan all of / for setuid/capabilities (slower)
  -h, --help        this help
      --version     print version

Exit code is an attention count, not a safety verdict:
  0  nothing needs your eyes      10  items need your eyes      1  tool error

This tool never says "SAFE". It hands you a complete inventory; you decide
which entries you recognise. It makes no network calls and writes nothing
unless you pass --save.
EOF
}

parse_args() {
  while [ $# -gt 0 ]; do
    case "$1" in
      -v|--verbose) VERBOSE=1 ;;
      --no-color)   NO_COLOR_FLAG=1 ;;
      --save)
        shift
        if [ $# -eq 0 ] || [[ "$1" == -* ]]; then
          echo "revelio: --save needs a FILE" >&2; exit 1
        fi
        SAVE_FILE="$1"
        ;;
      --thorough)   THOROUGH=1 ;;
      -h|--help)    usage; exit 0 ;;
      --version)    echo "revelio $VERSION"; exit 0 ;;
      *)            echo "revelio: unknown option: $1" >&2; exit 1 ;;
    esac
    shift
  done
}

# ---- checks ------------------------------------------------------------------

# enumerate home directories (root + everything under /home) within REVELIO_ROOT
_home_dirs() {
  printf '%s\n' "$REVELIO_ROOT/root"
  local d
  for d in "$REVELIO_ROOT"/home/*; do [ -d "$d" ] && printf '%s\n' "$d"; done
}

check_ssh() {
  local home ak line mtime
  # 1) authorized_keys in every home
  while IFS= read -r home; do
    ak="$home/.ssh/authorized_keys"
    [ -f "$ak" ] || continue
    _within_revelio_root "$ak" || continue
    _readable "$ak" || continue   # another user's 0600 keys in an 0755 home — blindspot, don't leak an open error
    mtime="$(date -r "$ak" '+%Y-%m-%d' 2>/dev/null || echo '?')"
    # `|| [ -n "$line" ]` picks up a final line with no trailing newline
    while IFS= read -r line || [ -n "$line" ]; do
      [ -n "$line" ] || continue
      case "$line" in \#*) continue ;; esac
      local ktype="(unknown)" kcomment="(none)" _kf j
      read -ra _kf <<<"$line"
      for j in "${!_kf[@]}"; do
        case "${_kf[$j]}" in
          ssh-*|ecdsa-*|sk-ssh-*|sk-ecdsa-*)
            ktype="${_kf[$j]}"
            [ $((j + 2)) -lt "${#_kf[@]}" ] && kcomment="${_kf[*]:$((j + 2))}"
            break ;;
        esac
      done
      emit attention ssh "SSH key in ${ak#"$REVELIO_ROOT"}" \
        "type: $ktype"$'\n'"comment: $kcomment"$'\n'"file mtime: $mtime" \
        "edit ${ak#"$REVELIO_ROOT"} and delete the line if you don't recognise it"
    done < "$ak"
  done < <(_home_dirs)

  # 2) sshd_config danger knobs
  local cfg="$REVELIO_ROOT/etc/ssh/sshd_config" key val
  [ -f "$cfg" ] || return 0
  while read -r key val; do
    case "$key" in
      PermitRootLogin)       [ "$val" = yes ] && emit attention ssh "PermitRootLogin yes" "root may log in over SSH" "set 'PermitRootLogin no' in $cfg" ;;
      PasswordAuthentication)[ "$val" = yes ] && emit attention ssh "PasswordAuthentication yes" "password logins allowed (brute-forceable)" "set 'PasswordAuthentication no' in $cfg" ;;
      AuthorizedKeysCommand) emit attention ssh "AuthorizedKeysCommand set" "sshd runs '$val' to fetch keys at login — a remote-key vector" "review/remove this line in $cfg" ;;
      TrustedUserCAKeys)     emit attention ssh "TrustedUserCAKeys set" "cert-based access trusting CA '$val' — anyone with the CA private key can mint a login" "review/remove this line in $cfg" ;;
    esac
  done < <(grep -iE '^[[:space:]]*(PermitRootLogin|PasswordAuthentication|AuthorizedKeysCommand|TrustedUserCAKeys)[[:space:]]' "$cfg" 2>/dev/null) || true
  return 0
}

# Enumerate every sudoers file that's actually in effect: /etc/sudoers,
# /etc/sudoers.d/* (which a stock /etc/sudoers @includedir's in, but we scan
# it directly too in case that directive was edited out), plus anything
# reached transitively via @include/#include (one file) or
# @includedir/#includedir (a whole directory) directives — sudo accepts
# both the modern '@' and legacy '#' spelling of these directives.
_sudoers_files() {
  local queue=("$REVELIO_ROOT/etc/sudoers") seen=() f line inc target
  for f in "$REVELIO_ROOT"/etc/sudoers.d/*; do [ -f "$f" ] && queue+=("$f"); done
  while [ "${#queue[@]}" -gt 0 ]; do
    f="${queue[0]}"; queue=("${queue[@]:1}")
    case " ${seen[*]:-} " in *" $f "*) continue ;; esac
    seen+=("$f")
    [ -f "$f" ] || continue
    printf '%s\n' "$f"
    _within_revelio_root "$f" || continue
    [ -r "$f" ] || continue   # unreadable (e.g. /etc/sudoers is 0440 — no root) — skip, don't leak an open error
    while IFS= read -r line; do
      case "$line" in
        '@include '*|'#include '*)
          inc="${line#*include }"
          target="$REVELIO_ROOT$inc"
          [ -f "$target" ] && queue+=("$target")
          ;;
        '@includedir '*|'#includedir '*)
          inc="${line#*includedir }"
          for target in "$REVELIO_ROOT$inc"/*; do
            [ -f "$target" ] && queue+=("$target")
          done
          ;;
      esac
    done < "$f" 2>/dev/null
  done
}

check_accounts() {
  local passwd="$REVELIO_ROOT/etc/passwd"
  local shadow="$REVELIO_ROOT/etc/shadow"
  local group="$REVELIO_ROOT/etc/group"
  local name pw uid home shell

  # 1) accounts: extra UID-0, human accounts with login shells, plus two
  # quieter shapes of "someone left themselves a login": a UID<1000 (normally
  # a system/service account) that nonetheless has a real shell AND a set
  # password hash, or a UID>=1000 human-range account with a real shell but
  # a home outside /home (so it doesn't look like the rest of the real users
  # at a glance).
  local shadow_pw
  if [ -f "$passwd" ]; then
    while IFS=: read -r name pw uid _ _ home shell; do
      [ -n "$name" ] || continue
      if [ "$uid" = 0 ] && [ "$name" != root ]; then
        emit attention accounts "Second UID 0 account: $name" \
          "uid: 0 (root-equivalent)"$'\n'"home: $home"$'\n'"shell: $shell" \
          "userdel $name   # if you didn't create it"
        continue
      fi
      case "$shell" in
        */nologin|*/false|"") continue ;;
      esac
      if [ "$uid" -gt 0 ] 2>/dev/null && [ "$uid" -lt 1000 ] 2>/dev/null && [ -r "$shadow" ]; then
        shadow_pw="$(awk -F: -v u="$name" '$1==u{print $2}' "$shadow" 2>/dev/null)"
        case "$shadow_pw" in
          ''|'!'|'!'*|'*'|'*'*) : ;;   # locked / no password set — not login-capable
          *)
            emit attention accounts "Login-capable low-UID account: $name" \
              "uid: $uid (< 1000, normally a system account)"$'\n'"home: $home"$'\n'"shell: $shell" \
              "passwd -l $name   # if you didn't intend this account to log in"
            ;;
        esac
      elif [ "$uid" -ge 1000 ] 2>/dev/null; then
        case "$home" in
          /home/*|/root) : ;;
          *) emit attention accounts "Human-range account with home outside /home: $name" \
               "uid: $uid"$'\n'"home: $home"$'\n'"shell: $shell" \
               "review the account — a real user's home is normally under /home" ;;
        esac
      fi
    done < "$passwd"
  fi

  # 2) empty-password accounts (shadow field 2 empty)
  if [ -r "$shadow" ]; then
    while IFS=: read -r name pw _; do
      [ -n "$name" ] || continue
      if [ -z "$pw" ]; then
        emit attention accounts "Account with empty password: $name" \
          "this account can log in with no password" "passwd -l $name   # lock it"
      fi
    done < "$shadow"
  else
    [ -f "$shadow" ] && blindspot "/etc/shadow (need root to read empty-password accounts)"
  fi

  # 3) sudoers NOPASSWD — including rules that only live in a file reached via
  # @include/#include (single file) or @includedir/#includedir (a whole dir),
  # which /etc/sudoers.d is itself conventionally pulled in through.
  if [ -d "$REVELIO_ROOT/etc/sudoers.d" ] && [ ! -r "$REVELIO_ROOT/etc/sudoers.d" ]; then
    blindspot "/etc/sudoers.d/ (need root to enumerate)"
  fi
  local f
  while IFS= read -r f; do
    [ -f "$f" ] || continue
    _within_revelio_root "$f" || continue
    _readable "$f" || continue   # top file, sudoers.d entry or an @include'd file we can't read — blindspot it
    if grep -qiE 'NOPASSWD' "$f" 2>/dev/null; then
      emit attention accounts "NOPASSWD sudoers rule in ${f#"$REVELIO_ROOT"}" \
        "$(grep -iE 'NOPASSWD' "$f")" "review ${f#"$REVELIO_ROOT"} with visudo"
    fi
  done < <(_sudoers_files)

  # 4) dangerous group membership (docker == root-equivalent; wheel/sudo == admin)
  if [ -f "$group" ]; then
    local gname members
    while IFS=: read -r gname _ _ members; do
      [ -n "$members" ] || continue
      case "$gname" in
        docker) emit attention accounts "Members of docker group: $members" \
                  "docker group membership is root-equivalent" "gpasswd -d <user> docker   # if unexpected" ;;
        wheel|sudo) emit normal accounts "Members of $gname group: $members" "admin group membership" "" ;;
      esac
    done < "$group"
  fi
  return 0
}

# best-effort: resolve a process name to its binary path (live system only)
_resolve_bin() { command -v "$1" 2>/dev/null || true; }

check_listening() {
  if [ -n "$REVELIO_ROOT" ]; then
    blindspot "listening sockets (live-only; not available when auditing REVELIO_ROOT=$REVELIO_ROOT)"
    return 0
  fi
  local line addr proc pname bin
  # -H omits header; -p needs root for full process info -> note blind spot if empty
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    addr="$(awk '{print $4}' <<<"$line")"
    proc="$(grep -oE 'users:\(\("[^"]+"' <<<"$line" | sed -E 's/.*\("//; s/"$//')"
    pname="${proc:-unknown}"
    if [ -z "$proc" ]; then
      blindspot "process names for listening sockets (need root for ss -p)"
    fi
    bin="$(_resolve_bin "$pname")"
    if [ -n "$bin" ]; then
      classify_provenance "$bin" listen "Listening: $addr ($pname)" \
        "binary: $bin" "stop/remove the service if you don't recognise it"
    else
      emit attention listen "Listening: $addr ($pname)" \
        "binary: unresolved" "identify the process: ss -tlnp | grep '$addr'"
    fi
  done < <(revelio_ss -tlnpH; revelio_ss -ulnpH)
  return 0
}

check_tunnels() {
  if [ -n "$REVELIO_ROOT" ]; then
    blindspot "outbound tunnels (live-only; not available when auditing REVELIO_ROOT)"
    return 0
  fi
  local line cmd argv0 base
  while IFS= read -r line; do
    cmd="${line#"${line%%[![:space:]]*}"}"   # ltrim
    cmd="${cmd#* }"                            # drop pid column
    argv0="${cmd%% *}"
    base="${argv0##*/}"   # match on the binary name, not the full invocation path
    case "$base" in
      autossh) emit attention tunnel "autossh persistent tunnel" "cmd: $cmd" "kill the autossh process / remove its unit if unexpected" ;;
      *) case "$cmd" in
           # -R (short reverse-forward) or its `-o Key=Value` equivalents:
           # RemoteForward= sets up the same reverse tunnel; ProxyCommand can
           # pipe the connection through anything, including a tunnel binary.
           *ssh*-R*|*ssh*RemoteForward*|*ssh*ProxyCommand*)
             emit attention tunnel "ssh reverse tunnel / proxy" "cmd: $cmd" "kill the ssh process if unexpected" ;;
           *cloudflared*tunnel*) emit attention tunnel "cloudflared tunnel running" "cmd: $cmd" "this exposes the box outward; remove if you didn't set it up" ;;
           *ngrok*|*frpc*|*frps*|*tailscaled*|*zerotier*) emit attention tunnel "remote-access daemon: ${cmd%% *}" "cmd: $cmd" "remove the daemon if you didn't set it up" ;;
         esac ;;
    esac
  done < <(revelio_ps -eo pid=,args= 2>/dev/null)
  return 0
}

# 0 if readable; if it exists but isn't readable, record a blindspot and return 1
_readable() {
  [ -r "$1" ] && return 0
  [ -e "$1" ] && blindspot "${1#"$REVELIO_ROOT"} (not readable without root)"
  return 1
}

# When REVELIO_ROOT is set (auditing a mounted image, not the live host),
# refuse to follow any path whose realpath resolves outside REVELIO_ROOT.
# Without this, a symlink planted inside the image (e.g. a fixed-up
# etc/pam.d entry pointing at /etc/hostname) would make us read and quote a
# LIVE-HOST file into the report. When REVELIO_ROOT is empty (auditing the
# live host itself) there is no "outside" to escape, so this is a no-op.
_within_revelio_root() {
  local p="$1" rp rr
  [ -n "$REVELIO_ROOT" ] || return 0
  rp="$(realpath -e "$p" 2>/dev/null)" || return 0   # nonexistent target: let normal -f/-e checks handle it
  rr="$(realpath -e "$REVELIO_ROOT" 2>/dev/null)" || return 0
  case "$rp" in
    "$rr"|"$rr"/*) return 0 ;;
    *) blindspot "skipped symlink escaping REVELIO_ROOT: ${p#"$REVELIO_ROOT"} -> $rp"; return 1 ;;
  esac
}

_is_fetch_exec() { # 0 if text pipes a download into a shell (or decodes into one)
  printf '%s' "$1" | grep -qE "$FETCHEXEC_RE"
}

check_scheduled() {
  local f content
  # /etc/cron.d + /etc/cron.{hourly,daily,weekly,monthly} + /etc/crontab
  for f in "$REVELIO_ROOT"/etc/cron.d/* \
           "$REVELIO_ROOT"/etc/cron.hourly/* "$REVELIO_ROOT"/etc/cron.daily/* \
           "$REVELIO_ROOT"/etc/cron.weekly/* "$REVELIO_ROOT"/etc/cron.monthly/* \
           "$REVELIO_ROOT/etc/crontab"; do
    [ -f "$f" ] || continue
    _within_revelio_root "$f" || continue
    _readable "$f" || continue
    content="$(grep -vE '^\s*(#|$)' "$f" 2>/dev/null | head -20)"
    local rem="remove ${f#"$REVELIO_ROOT"} if you didn't create it"
    local detail="file: ${f#"$REVELIO_ROOT"}"$'\n'"$content"
    if _is_fetch_exec "$content"; then
      emit attention sched "Cron job that fetch-execs: ${f##*/}" "$detail" "$rem"
    else
      classify_provenance "$f" sched "Cron job: ${f##*/}" "$detail" "$rem"
    fi
  done

  # per-user crontabs (need root for others)
  local spool="$REVELIO_ROOT/var/spool/cron"
  if [ -d "$spool" ]; then
    for f in "$spool"/* "$spool"/crontabs/*; do
      [ -f "$f" ] || continue
      _within_revelio_root "$f" || continue
      _readable "$f" || continue
      content="$(grep -vE '^\s*(#|$)' "$f" 2>/dev/null | head -20)"
      emit attention sched "User crontab: ${f##*/}" "file: ${f#"$REVELIO_ROOT"}"$'\n'"$content" \
        "crontab -u ${f##*/} -e   # review"
    done
  fi

  # systemd timers (live-only)
  if [ -z "$REVELIO_ROOT" ] && command -v systemctl >/dev/null 2>&1; then
    local unit
    while read -r unit _; do
      case "$unit" in *.timer)
        local path; path="$(systemctl show -p FragmentPath --value "$unit" 2>/dev/null)"
        if [ -n "$path" ]; then
          classify_provenance "$path" sched "systemd timer: $unit" "unit file: $path" "systemctl disable --now $unit   # if unexpected"
        fi
      ;; esac
    done < <(systemctl list-timers --all --no-legend 2>/dev/null | awk '{print $NF}')
  fi

  # system-wide systemd timer UNIT FILES (works against REVELIO_ROOT too,
  # unlike the live-only `systemctl list-timers` above)
  for f in "$REVELIO_ROOT"/etc/systemd/system/*.timer; do
    [ -f "$f" ] || continue
    _within_revelio_root "$f" || continue
    _readable "$f" || continue
    content="$(grep -vE '^\s*(#|;|$)' "$f" 2>/dev/null | head -20)"
    classify_provenance "$f" sched "systemd timer unit: ${f##*/}" \
      "file: ${f#"$REVELIO_ROOT"}"$'\n'"$content" \
      "systemctl disable --now ${f##*/}   # if unexpected; then remove ${f#"$REVELIO_ROOT"}"
  done

  # per-user systemd timers (~/.config/systemd/user/*.timer)
  local home
  while IFS= read -r home; do
    for f in "$home"/.config/systemd/user/*.timer; do
      [ -f "$f" ] || continue
      _within_revelio_root "$f" || continue
      _readable "$f" || continue
      content="$(grep -vE '^\s*(#|;|$)' "$f" 2>/dev/null | head -20)"
      emit attention sched "user systemd timer: ${f##*/}" \
        "file: ${f#"$REVELIO_ROOT"}"$'\n'"$content" \
        "systemctl --user disable --now ${f##*/}   # if unexpected; then remove ${f#"$REVELIO_ROOT"}"
    done
  done < <(_home_dirs)

  # at(1) spool jobs — location varies by distro
  local atdir
  for atdir in "$REVELIO_ROOT/var/spool/cron/atjobs" "$REVELIO_ROOT/var/spool/at/spool" \
               "$REVELIO_ROOT/var/spool/atjobs" "$REVELIO_ROOT/var/spool/at"; do
    [ -d "$atdir" ] || continue
    for f in "$atdir"/*; do
      [ -f "$f" ] || continue
      case "${f##*/}" in .SEQ|spool) continue ;; esac
      _within_revelio_root "$f" || continue
      _readable "$f" || continue
      content="$(grep -vE '^\s*(#|$)' "$f" 2>/dev/null | head -20)"
      local rem="atrm ${f##*/}   # if unexpected, or remove ${f#"$REVELIO_ROOT"}"
      local detail="file: ${f#"$REVELIO_ROOT"}"$'\n'"$content"
      if _is_fetch_exec "$content"; then
        emit attention sched "at(1) job that fetch-execs: ${f##*/}" "$detail" "$rem"
      else
        emit attention sched "at(1) job: ${f##*/}" "$detail" "$rem"
      fi
    done
  done

  # anacron: /etc/anacrontab (its presence/content is not package-owned even
  # though the anacron binary and /etc/cron.d/anacron typically are)
  f="$REVELIO_ROOT/etc/anacrontab"
  if [ -f "$f" ] && _within_revelio_root "$f" && _readable "$f"; then
    content="$(grep -vE '^\s*(#|$)' "$f" 2>/dev/null | head -20)"
    emit attention sched "anacrontab: ${f#"$REVELIO_ROOT"}" \
      "file: ${f#"$REVELIO_ROOT"}"$'\n'"$content" \
      "review ${f#"$REVELIO_ROOT"} — anacron entries run scheduled jobs even after downtime"
  fi
  return 0
}

check_persistence() {
  local f line home

  # 1) PAM modules that run code on every auth
  for f in "$REVELIO_ROOT"/etc/pam.d/*; do
    [ -f "$f" ] || continue
    _within_revelio_root "$f" || continue
    _readable "$f" || continue
    if grep -qE 'pam_exec\.so|pam_python|pam_script' "$f" 2>/dev/null; then
      emit attention persist "PAM runs external code: ${f##*/}" \
        "$(grep -E 'pam_exec\.so|pam_python|pam_script' "$f")" \
        "review ${f#"$REVELIO_ROOT"} — pam_exec runs on every auth"
    fi
  done

  # 2) ld.so.preload (LD_PRELOAD persistence / rootkit hook)
  f="$REVELIO_ROOT/etc/ld.so.preload"
  if [ -s "$f" ] && _within_revelio_root "$f" && _readable "$f"; then
    emit attention persist "/etc/ld.so.preload is non-empty" \
      "preloads into EVERY process:"$'\n'"$(cat "$f")" \
      "inspect each .so; empty the file if you didn't set it up"
  fi

  # 3) rc.local
  f="$REVELIO_ROOT/etc/rc.local"
  if [ -s "$f" ] && _within_revelio_root "$f" && _readable "$f" && grep -qvE '^\s*(#|exit|$)' "$f" 2>/dev/null; then
    emit attention persist "/etc/rc.local has boot commands" "$(grep -vE '^\s*(#|exit|$)' "$f" | head)" \
      "review /etc/rc.local"
  fi

  # 4) profile.d + shell rc files: look for fetch-exec / reverse shells
  local targets=()
  for f in "$REVELIO_ROOT"/etc/profile.d/*; do [ -f "$f" ] && targets+=("$f"); done
  while IFS= read -r home; do
    for f in "$home/.bashrc" "$home/.bash_profile" "$home/.profile" "$home/.zshrc"; do
      [ -f "$f" ] && targets+=("$f")
    done
  done < <(_home_dirs)

  for f in "${targets[@]:-}"; do
    [ -f "$f" ] || continue
    _within_revelio_root "$f" || continue
    _readable "$f" || continue
    if grep -qE "$FETCHEXEC_RE|$REVSHELL_RE" "$f" 2>/dev/null; then
      emit attention persist "Suspicious line in ${f#"$REVELIO_ROOT"}" \
        "$(grep -nE "$FETCHEXEC_RE|$REVSHELL_RE" "$f" | head)" \
        "edit ${f#"$REVELIO_ROOT"} and remove the line if you don't recognise it"
    fi
  done
  return 0
}

check_escalation() {
  local scan_root="${REVELIO_ROOT:-/}" f
  # default: common dirs; --thorough: whole tree
  local dirs
  if [ "$THOROUGH" -eq 1 ]; then
    dirs=("$scan_root")
  else
    dirs=("$scan_root/usr" "$scan_root/bin" "$scan_root/sbin" "$scan_root/opt" "$scan_root/home" "$scan_root/root" "$scan_root/tmp" "$scan_root/var/tmp")
  fi

  # -xdev stays within each start dir's filesystem (won't follow into separate mounts);
  # acceptable for the common-dirs default. --thorough still honors -xdev from scan_root.
  while IFS= read -r -d '' f; do
    [ -n "$f" ] || continue
    classify_provenance "$f" escalate "setuid/setgid binary: ${f#"$scan_root"}" \
      "perms: $(stat -c '%A' "$f" 2>/dev/null)" \
      "if hand-placed and unexpected: chmod u-s,g-s '${f#"$scan_root"}' or remove it"
  done < <(find "${dirs[@]}" -xdev -type f \( -perm -4000 -o -perm -2000 \) -print0 2>/dev/null)

  # non-root can't traverse root-only dirs; record the gap (mirrors the shadow/_readable pattern)
  if [ -z "$REVELIO_ROOT" ] && [ -d /root ] && [ ! -x /root ]; then
    blindspot "/root (setuid scan incomplete — need root to traverse)"
  fi

  # file capabilities (live-only; getcap needs the real fs)
  if [ -z "$REVELIO_ROOT" ] && command -v getcap >/dev/null 2>&1; then
    while IFS= read -r line; do
      [ -n "$line" ] || continue
      local capf="${line%% *}"
      classify_provenance "$capf" escalate "file capability: $line" \
        "capabilities grant elevated powers without setuid" \
        "setcap -r '$capf'   # if unexpected"
    done < <(revelio_getcap -r "${dirs[@]}" 2>/dev/null)
  elif [ -z "$REVELIO_ROOT" ]; then
    blindspot "file capabilities (getcap not installed — install libcap or libcap2-bin to check)"
  fi
  return 0
}

run_all_checks() {
  check_ssh
  check_accounts
  check_listening
  check_tunnels
  check_scheduled
  check_persistence
  check_escalation
}

revelio_main() {
  parse_args "$@"
  _validate_revelio_root || exit 1
  setup_color
  revelio_pm_detect
  run_all_checks
  local out; out="$(revelio_render)"
  printf '%s\n' "$out"
  if [ -n "$SAVE_FILE" ]; then
    # Refuse to write through a symlink (would write to whatever it points at,
    # possibly outside anything the caller intended) and refuse anything that
    # exists but isn't a plain regular file. New files are created 0600 via
    # umask, since the report may contain key comments, filenames, and other
    # details the operator wouldn't want world/group-readable.
    if [ -L "$SAVE_FILE" ]; then
      echo "revelio: --save FILE must not be a symlink: $SAVE_FILE" >&2
      exit 1
    fi
    if [ -e "$SAVE_FILE" ] && [ ! -f "$SAVE_FILE" ]; then
      echo "revelio: --save FILE exists and is not a regular file: $SAVE_FILE" >&2
      exit 1
    fi
    ( umask 077 && printf '%s\n' "$out" | strip_ansi > "$SAVE_FILE" )
  fi
  [ "$_N_ATTENTION" -gt 0 ] && return 10
  return 0
}

# ---- source-guard: run main only when executed, not when sourced ------------
if [ "${BASH_SOURCE[0]}" = "$0" ]; then
  revelio_main "$@"
  exit $?
fi
